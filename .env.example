# Copy to .env when you want a judge other than the defaults.
# Do not commit a real key. Expo only exposes variables that start with EXPO_PUBLIC_.

# Leave empty to use the public Judge0 instance at https://ce.judge0.com for Python.
# Set EXPO_PUBLIC_JUDGE0_PUBLIC=0 to turn that public instance off.
EXPO_PUBLIC_JUDGE0_URL=
EXPO_PUBLIC_JUDGE0_KEY=
EXPO_PUBLIC_JUDGE0_PUBLIC=

# Public Piston (emkc.org) no longer executes code. Set this only for a Piston you host.
EXPO_PUBLIC_PISTON_URL=
